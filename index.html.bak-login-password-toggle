<!doctype html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>La Patrona VIP · Operación de discoteca</title>
  <link rel="stylesheet" href="styles.css" />
</head>

<body class="auth-locked">

  <div class="login-screen" id="login-screen">
    <div class="login-panel">

      <div class="login-brand">
        <div class="login-brand-mark">
          P
        </div>

        <div>
          <strong>
            La Patrona VIP
          </strong>

          <span>
            Sistema de operación
          </span>
        </div>
      </div>


      <div class="login-heading">
        <p class="eyebrow">
          ACCESO SEGURO
        </p>

        <h1>
          Iniciar sesión
        </h1>

        <p>
          Ingresa tus credenciales para
          acceder al sistema.
        </p>
      </div>


      <form id="login-form">

        <label class="login-field">
          <span>
            Usuario
          </span>

          <input class="input" id="login-username" name="username" type="text" autocomplete="username"
            placeholder="Usuario" required />
        </label>


        <label class="login-field">
          <span>
            Contraseña
          </span>

          <input class="input" id="login-password" name="password" type="password" autocomplete="current-password"
            placeholder="Contraseña" required />
        </label>


        <div class="login-error" id="login-error" hidden></div>


        <button type="submit" class="btn login-submit" id="login-submit">
          Iniciar sesión
        </button>

      </form>


      <div class="login-footer">
        La Patrona VIP · Control interno
      </div>

    </div>
  </div>


  <div class="shell">
    <aside class="sidebar">
      <div class="brand"><span class="brand-mark">P</span>
        <div><strong>La Patrona</strong><small>VIP</small></div>
      </div>
      <p class="eyebrow">OPERACIÓN</p>
      <nav id="nav">
        <button type="button" class="nav-item active" data-view="dashboard" aria-label="Dashboard">
          <span class="nav-icon">⌂</span>
          <span class="nav-label">Dashboard</span>
        </button>

        <button type="button" class="nav-item" data-view="sales" aria-label="Ventas y caja">
          <span class="nav-icon">▣</span>
          <span class="nav-label">Ventas y caja</span>
        </button>

        <button type="button" class="nav-item" data-view="inventory" aria-label="Inventario">
          <span class="nav-icon">◈</span>
          <span class="nav-label">Inventario</span>
        </button>

        <button type="button" class="nav-item" data-view="expenses" aria-label="Gastos">
          <span class="nav-icon">↘</span>
          <span class="nav-label">Gastos</span>
        </button>

        <button type="button" class="nav-item" data-view="invoices" aria-label="Facturación electrónica">
          <span class="nav-icon">▤</span>
          <span class="nav-label">
            Facturación electrónica
          </span>
        </button>

        <button type="button" class="nav-item" data-view="users" aria-label="Usuarios" hidden>
          <span class="nav-icon">♙</span>
          <span class="nav-label">
            Usuarios
          </span>
        </button>

        <button type="button" class="nav-item" data-view="audit" aria-label="Auditoría" hidden>
          <span class="nav-icon">◎</span>
          <span class="nav-label">
            Auditoría
          </span>
        </button>

      </nav>
      <div class="sidebar-foot"><span class="status-dot"></span> Sistema en línea<br><small>Una sede · Bogotá</small>
      </div>
    </aside>
    <main class="main">
      <header class="topbar">
        <div>
          <p class="eyebrow">LUNES, 24 DE AGOSTO DE 2026</p>
          <h1 id="view-title">Resumen de hoy</h1>
        </div>
        <div class="top-actions">

          <div class="topbar-user">
            <div class="topbar-user-text">
              <strong id="current-user-name">
                Usuario
              </strong>

              <small id="current-user-role">
                —
              </small>
            </div>

            <div class="avatar" id="current-user-avatar">
              U
            </div>
          </div>

          <button class="icon-btn logout-btn" id="logout-button" type="button" title="Cerrar sesión"
            aria-label="Cerrar sesión">
            ↪
          </button>

        </div>
      </header>
      <div id="app"></div>
    </main>
  </div>
  <div id="toast" class="toast"></div>
  <script src="app.js"></script>
</body>

</html>