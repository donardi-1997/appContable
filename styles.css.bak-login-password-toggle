:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif;
  color: #f5ede2;
  background: #080605;
  --bg: #080605;
  --bg-soft: #0d0908;
  --panel: #15100d;
  --panel2: #1d1511;
  --wine: #5c0909;
  --wine-dark: #2f0505;
  --wine-soft: #7a1414;
  --gold: #d6a542;
  --gold-light: #f0c66a;
  --gold-muted: #9f7a38;
  --line: rgba(214, 165, 66, .18);
  --line-strong: rgba(214, 165, 66, .35);
  --text: #f5ede2;
  --muted: #a99d8d;
  --green: #6fa783;
  --red: #d36d64;
  --yellow: #d6a542;
  --shadow:
    0 18px 45px rgba(0, 0, 0, .28);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--bg);
}

body {
  margin: 0;
  color: var(--text);
  background:
    radial-gradient(circle at 80% -10%,
      rgba(92, 9, 9, .22) 0,
      transparent 34%),
    radial-gradient(circle at 12% 110%,
      rgba(214, 165, 66, .08) 0,
      transparent 30%),
    var(--bg);
  min-height: 100vh;
}

::selection {
  background: rgba(214, 165, 66, .28);
  color: #fff7ea;
}

/* ============================================================
   LAYOUT
============================================================ */
.shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 248px;
  border-right: 1px solid var(--line);
  padding: 28px 18px;
  display: flex;
  flex-direction: column;
  background:
    linear-gradient(180deg,
      rgba(92, 9, 9, .18),
      transparent 24%),
    #0d0908;
  box-shadow:
    12px 0 40px rgba(0, 0, 0, .22);
}

.main {
  flex: 1;
  padding: 32px 44px;
  max-width: 1440px;
  margin: auto;
  width: 100%;
}

/* ============================================================
   BRAND
============================================================ */
.brand {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 18px;
  margin: 0 10px 44px;
  color: #fff4df;
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background:
    linear-gradient(145deg,
      var(--gold-light),
      var(--gold),
      #8b6423);
  color: #1a0d05;
  font-weight: 900;
  box-shadow:
    0 0 0 1px rgba(255, 220, 145, .2),
    0 8px 24px rgba(214, 165, 66, .18);
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
  margin-top: 2px;
}

/* ============================================================
   NAVIGATION
============================================================ */
.eyebrow {
  color: var(--gold-muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .16em;
  margin: 0 0 12px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 13px 12px;
  border: 1px solid transparent;
  background: transparent;
  color: #aa9d8d;
  border-radius: 9px;
  text-align: left;
  font-size: 14px;
  margin: 3px 0;
  cursor: pointer;
  transition:
    background .18s ease,
    color .18s ease,
    border-color .18s ease;
}

.nav-item:hover {
  background: rgba(92, 9, 9, .18);
  color: #f5e9d7;
  border-color: rgba(214, 165, 66, .08);
}

.nav-item.active {
  color: #fff2d8;
  background:
    linear-gradient(90deg,
      rgba(92, 9, 9, .72),
      rgba(92, 9, 9, .20));
  border-color: rgba(214, 165, 66, .18);
  box-shadow:
    inset 3px 0 var(--gold),
    0 6px 18px rgba(0, 0, 0, .15);
}

.sidebar-foot {
  margin-top: auto;
  color: #b5a897;
  font-size: 12px;
  line-height: 1.7;
  padding: 14px 10px;
  border-top: 1px solid var(--line);
}

.sidebar-foot small {
  color: var(--muted);
}

.status-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  background: var(--green);
  border-radius: 50%;
  margin-right: 5px;
  box-shadow:
    0 0 10px rgba(111, 167, 131, .5);
}

/* ============================================================
   TOPBAR
============================================================ */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30px;
}

.topbar h1 {
  font-size: 30px;
  margin: 0;
  font-weight: 750;
  letter-spacing: -.025em;
  color: #fff5e7;
}

.top-actions {
  display: flex;
  gap: 14px;
  align-items: center;
}

.icon-btn {
  border: 1px solid var(--line);
  background:
    linear-gradient(180deg,
      rgba(255, 255, 255, .025),
      transparent),
    var(--panel);
  color: #e3d4bd;
  border-radius: 9px;
  padding: 9px 14px;
  font-size: 18px;
  cursor: pointer;
}

.icon-btn:hover {
  border-color: var(--line-strong);
  color: var(--gold-light);
}

.avatar {
  background:
    linear-gradient(145deg,
      var(--wine-soft),
      var(--wine-dark));
  color: #f6d9a0;
  border: 1px solid rgba(214, 165, 66, .3);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 12px;
  box-shadow:
    0 7px 20px rgba(0, 0, 0, .25);
}

/* ============================================================
   GRIDS
============================================================ */
.grid {
  display: grid;
  gap: 18px;
}

.metrics {
  grid-template-columns: repeat(4, 1fr);
}

.twocol {
  grid-template-columns: 1.55fr 1fr;
  margin-top: 18px;
}

/* ============================================================
   CARDS
============================================================ */
.card {
  background:
    linear-gradient(180deg,
      rgba(255, 255, 255, .018),
      transparent 45%),
    rgba(21, 16, 13, .96);
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 20px;
  box-shadow:
    0 12px 32px rgba(0, 0, 0, .16);
}

.card:hover {
  border-color: rgba(214, 165, 66, .25);
}

.metric .label {
  color: var(--muted);
  font-size: 12px;
}

.metric .value {
  font-size: 28px;
  font-weight: 780;
  margin: 10px 0 4px;
  color: #fff2d8;
}

.delta {
  font-size: 12px;
}

.positive {
  color: var(--green);
}

.negative {
  color: var(--red);
}

.card h2 {
  font-size: 15px;
  margin: 0 0 18px;
  color: #f3e8d6;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.link {
  color: var(--gold-light);
  font-size: 12px;
  cursor: pointer;
}

/* ============================================================
   DASHBOARD CHART
============================================================ */
.bars {
  height: 180px;
  display: flex;
  align-items: end;
  gap: 12px;
  padding: 10px 4px 0;
}

.bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: end;
  gap: 7px;
  align-items: center;
  color: var(--muted);
  font-size: 10px;
}

.bar {
  width: 100%;
  max-width: 36px;
  border-radius: 7px 7px 2px 2px;
  background:
    linear-gradient(180deg,
      var(--gold-light),
      var(--gold),
      #7c541b);
  box-shadow:
    0 6px 16px rgba(214, 165, 66, .12);
  min-height: 8px;
}

/* ============================================================
   LISTS
============================================================ */
.list {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 13px;
}

.row small {
  display: block;
  color: var(--muted);
  font-size: 11px;
  margin-top: 3px;
}

/* ============================================================
   STATUS PILLS
============================================================ */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 4px 9px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 700;
  background: rgba(214, 165, 66, .09);
  color: #c6ae7c;
  border: 1px solid rgba(214, 165, 66, .12);
}

.pill.green {
  background: rgba(80, 126, 94, .14);
  color: #91c5a0;
  border-color: rgba(111, 167, 131, .2);
}

.pill.yellow {
  background: rgba(214, 165, 66, .12);
  color: #eccb83;
  border-color: rgba(214, 165, 66, .22);
}

/* ============================================================
   BUTTONS
============================================================ */
.btn {
  border: 1px solid rgba(240, 198, 106, .12);
  border-radius: 8px;
  padding: 10px 15px;
  background:
    linear-gradient(180deg,
      var(--gold-light),
      var(--gold));
  color: #211206;
  font-weight: 800;
  cursor: pointer;
  box-shadow:
    0 7px 20px rgba(214, 165, 66, .12);
  transition:
    transform .15s ease,
    filter .15s ease,
    box-shadow .15s ease;
}

.btn:hover {
  filter: brightness(1.06);
  transform: translateY(-1px);
  box-shadow:
    0 10px 24px rgba(214, 165, 66, .18);
}

.btn:active {
  transform: translateY(0);
}

.btn:disabled {
  opacity: .55;
  cursor: not-allowed;
  transform: none;
}

.btn.secondary {
  background:
    linear-gradient(180deg,
      #261613,
      #1b100e);
  color: #e9d9c0;
  border-color: rgba(214, 165, 66, .16);
  box-shadow: none;
}

.btn.secondary:hover {
  border-color: rgba(214, 165, 66, .34);
  color: #fff0d3;
}

/* ============================================================
   TOOLBAR / INPUTS
============================================================ */
.toolbar {
  display: flex;
  gap: 10px;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 18px;
}

.input,
.select {
  background: #100c0a;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 10px 12px;
  color: #f2e7d6;
  outline: 0;
  transition:
    border-color .15s ease,
    box-shadow .15s ease;
}

.input:focus,
.select:focus {
  border-color: rgba(214, 165, 66, .48);
  box-shadow:
    0 0 0 3px rgba(214, 165, 66, .07);
}

.input::placeholder {
  color: #74695d;
}

select option {
  background: #15100d;
  color: #f1e6d5;
}

/* ============================================================
   TABLE
============================================================ */
.table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.table th {
  color: #958777;
  text-align: left;
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .09em;
  padding: 12px 8px;
  border-bottom: 1px solid var(--line);
}

.table td {
  padding: 14px 8px;
  border-bottom: 1px solid rgba(214, 165, 66, .08);
  color: #ded1bf;
}

.table tbody tr {
  transition: background .15s ease;
}

.table tbody tr:hover {
  background: rgba(92, 9, 9, .08);
}

.table strong {
  color: #f7ead4;
}

.table small {
  display: block;
  color: var(--muted);
  margin-top: 4px;
}

.empty {
  color: var(--muted);
  text-align: center;
  padding: 35px;
}

/* ============================================================
   INVOICE
============================================================ */
.invoice-box {
  border: 1px dashed rgba(214, 165, 66, .36);
  padding: 20px;
  border-radius: 12px;
  background:
    linear-gradient(135deg,
      rgba(92, 9, 9, .10),
      rgba(214, 165, 66, .025)),
    #100c0a;
}

.invoice-box h3 {
  margin: 0 0 7px;
  color: #f1dfc1;
}

.invoice-box p {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}

/* ============================================================
   FORMS
============================================================ */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #b9aa96;
  font-size: 12px;
  font-weight: 600;
}

.field.full {
  grid-column: 1/-1;
}

.field input,
.field select {
  width: 100%;
  background: #0e0a08;
  border: 1px solid var(--line);
  padding: 11px;
  border-radius: 8px;
  color: #f5ead9;
  outline: none;
}

.field input:focus,
.field select:focus {
  border-color: rgba(214, 165, 66, .5);
  box-shadow:
    0 0 0 3px rgba(214, 165, 66, .07);
}

/* ============================================================
   MODALS
============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 22px;
  background:
    rgba(4, 2, 2, .78);
  backdrop-filter:
    blur(7px);
}

.modal {
  width: min(620px, 100%);
  max-height: 90vh;
  overflow: auto;
  background:
    linear-gradient(180deg,
      rgba(92, 9, 9, .08),
      transparent 35%),
    #15100d;
  border: 1px solid rgba(214, 165, 66, .27);
  border-radius: 15px;
  padding: 24px;
  box-shadow:
    0 30px 80px rgba(0, 0, 0, .58),
    0 0 40px rgba(92, 9, 9, .06);
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 22px;
}

/* ============================================================
   TOAST
============================================================ */
.toast {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 1100;
  background:
    linear-gradient(135deg,
      #30100d,
      #1b100d);
  color: #f5dfba;
  border: 1px solid rgba(214, 165, 66, .27);
  padding: 13px 17px;
  border-radius: 10px;
  opacity: 0;
  transform: translateY(10px);
  transition: .2s;
  box-shadow:
    0 16px 40px rgba(0, 0, 0, .35);
}

.toast.show {
  opacity: 1;
  transform: none;
}

/* ============================================================
   SCROLLBAR
============================================================ */
::-webkit-scrollbar {
  width: 9px;
  height: 9px;
}

::-webkit-scrollbar-track {
  background: #090605;
}

::-webkit-scrollbar-thumb {
  background: #39231b;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #574026;
}

/* ============================================================
   RESPONSIVE
============================================================ */
@media(max-width:900px) {
  .sidebar {
    width: 72px;
    padding: 20px 10px;
  }

  .brand div,
  .nav-item span,
  .eyebrow,
  .sidebar-foot {
    display: none;
  }

  .brand {
    margin: 0 8px 35px;
  }

  .nav-item {
    justify-content: center;
  }

  .main {
    padding: 25px 18px;
  }

  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .twocol {
    grid-template-columns: 1fr;
  }
}

@media(max-width:560px) {
  .metrics {
    grid-template-columns: 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .main {
    padding: 18px 12px;
  }

  .topbar h1 {
    font-size: 22px;
  }

  .card {
    padding: 16px;
  }
}

/* ============================================================
   RESPONSIVE IMPROVEMENTS
============================================================ */
@media(max-width:1100px) {
  .main {
    padding: 28px 24px;
  }

  .metrics {
    grid-template-columns: repeat(2, 1fr);
  }

  .twocol {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: stretch;
  }

  .toolbar .input {
    flex: 1 1 220px;
  }

  .toolbar .select {
    flex: 0 1 180px;
  }

  .card {
    overflow: hidden;
  }

  .table {
    min-width: 760px;
  }

  .card:has(.table) {
    overflow-x: auto;
  }
}

@media(max-width:900px) {
  .shell {
    display: block;
  }

  .sidebar {
    width: 100%;
    min-height: auto;
    padding: 12px 14px;
    flex-direction: row;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 900;
    border-right: 0;
    border-bottom: 1px solid var(--line);
    box-shadow:
      0 10px 28px rgba(0, 0, 0, .28);
  }

  .brand {
    margin: 0 16px 0 0;
    flex-shrink: 0;
  }

  .brand-mark {
    width: 34px;
    height: 34px;
    font-size: 11px;
  }

  .brand div {
    display: block;
  }

  .brand strong {
    font-size: 13px;
  }

  .brand small {
    display: none;
  }

  .eyebrow {
    display: none;
  }

  #nav {
    display: flex;
    flex: 1;
    gap: 5px;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 2px;
  }

  #nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    width: auto;
    min-width: max-content;
    margin: 0;
    padding: 9px 11px;
    justify-content: center;
    font-size: 12px;
    border-radius: 8px;
  }

  .nav-item span {
    display: inline;
  }

  .nav-item.active {
    box-shadow: none;
  }

  .sidebar-foot {
    display: none;
  }

  .main {
    width: 100%;
    max-width: none;
    padding: 22px 18px 40px;
  }

  .topbar {
    gap: 16px;
    margin-bottom: 22px;
  }

  .topbar h1 {
    font-size: 25px;
  }

  .metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .field.full {
    grid-column: auto;
  }

  .modal {
    width: min(620px, calc(100vw - 30px));
  }
}

@media(max-width:700px) {
  .main {
    padding: 18px 14px 32px;
  }

  .topbar {
    align-items: center;
  }

  .topbar h1 {
    font-size: 22px;
  }

  .top-actions {
    gap: 8px;
  }

  .icon-btn {
    padding: 8px 11px;
  }

  .metrics {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .metric {
    padding: 16px;
  }

  .metric .value {
    font-size: 23px;
  }

  .toolbar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }

  .toolbar .btn {
    grid-column: 1/-1;
    width: 100%;
  }

  .toolbar .input,
  .toolbar .select {
    width: 100%;
    min-width: 0;
  }

  .card {
    padding: 16px;
    border-radius: 11px;
  }

  .table {
    min-width: 680px;
  }

  .modal-overlay {
    padding: 10px;
    align-items: end;
  }

  .modal {
    width: 100%;
    max-height: 92vh;
    border-radius: 16px 16px 0 0;
    padding: 20px 16px 24px;
  }

  .modal-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .modal-actions .btn {
    width: 100%;
  }
}

@media(max-width:520px) {
  body {
    background:
      radial-gradient(circle at 80% -10%,
        rgba(92, 9, 9, .18) 0,
        transparent 28%),
      var(--bg);
  }

  .sidebar {
    padding: 9px 10px;
  }

  .brand {
    margin-right: 8px;
  }

  .brand-mark {
    width: 32px;
    height: 32px;
  }

  .brand div {
    display: none;
  }

  .nav-item {
    padding: 8px 9px;
    font-size: 0;
    gap: 0;
  }

  .nav-item span {
    display: none;
  }

  .nav-item {
    font-size: 16px;
  }

  .main {
    padding: 16px 10px 28px;
  }

  .topbar {
    margin-bottom: 18px;
  }

  .topbar h1 {
    font-size: 20px;
  }

  .avatar {
    width: 32px;
    height: 32px;
  }

  .metrics {
    grid-template-columns: 1fr;
  }

  .toolbar {
    grid-template-columns: 1fr;
  }

  .toolbar .btn,
  .toolbar .input,
  .toolbar .select {
    grid-column: auto;
  }

  .card {
    padding: 14px;
  }

  .card-head {
    gap: 10px;
    align-items: flex-start;
  }

  .card h2 {
    font-size: 14px;
  }

  .table {
    min-width: 620px;
  }

  .table th {
    padding: 10px 7px;
  }

  .table td {
    padding: 12px 7px;
  }

  .btn {
    min-height: 42px;
  }

  .input,
  .select,
  .field input,
  .field select {
    min-height: 42px;
    font-size: 16px;
  }

  .toast {
    left: 10px;
    right: 10px;
    bottom: 12px;
    text-align: center;
  }
}

@media(max-width:380px) {
  .main {
    padding-left: 8px;
    padding-right: 8px;
  }

  .topbar h1 {
    font-size: 18px;
  }

  .card {
    padding: 12px;
  }

  .metric .value {
    font-size: 21px;
  }
}

/* ============================================================
   MOBILE OVERFLOW FIX
============================================================ */
html,
body {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

.shell,
.main,
.topbar,
.toolbar,
.card,
.grid,
.twocol,
.metrics {
  min-width: 0;
  max-width: 100%;
}

@media(max-width:700px) {
  .main {
