/* ============================================================
   DASHBOARD V2
============================================================ */

.dashboard-welcome {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 18px;

  padding: 4px 2px;
}

.dashboard-welcome h2 {
  margin: 0 0 6px;

  font-size: 20px;

  color: #fff3df;
}

.dashboard-welcome p:not(.eyebrow) {
  margin: 0;

  color: var(--muted);

  font-size: 13px;
}


.dashboard-metrics .metric {
  position: relative;

  overflow: hidden;
}

.dashboard-metrics .metric::after {
  content: "";

  position: absolute;

  width: 90px;
  height: 90px;

  right: -30px;
  top: -35px;

  border-radius: 50%;

  background:
    rgba(214, 165, 66, .035);

  pointer-events: none;
}


/* ============================================================
   MAIN DASHBOARD GRID
============================================================ */

.dashboard-main-grid {
  grid-template-columns:
    minmax(0, 1.55fr) minmax(300px, .85fr);

  margin-top: 18px;
}

.dashboard-bottom-grid {
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  margin-top: 18px;
}


/* ============================================================
   SALES CHART
============================================================ */

.dashboard-chart {
  height: 255px;

  display: grid;

  grid-template-columns:
    repeat(7, minmax(0, 1fr));

  gap: 12px;

  align-items: end;

  padding-top: 30px;
}

.dashboard-bar-item {
  height: 100%;

  display: grid;

  grid-template-rows:
    28px 1fr 22px;

  gap: 6px;

  min-width: 0;

  text-align: center;
}

.dashboard-bar-value {
  color: var(--muted);

  font-size: 9px;

  white-space: nowrap;

  overflow: hidden;

  text-overflow: ellipsis;
}

.dashboard-bar-track {
  height: 100%;

  display: flex;

  align-items: flex-end;

  justify-content: center;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, .018);

  overflow: hidden;
}

.dashboard-bar-fill {
  width: 68%;

  min-height: 3px;

  border-radius:
    6px 6px 2px 2px;

  background:
    linear-gradient(180deg,
      var(--gold-light),
      var(--wine-soft));

  box-shadow:
    0 0 16px rgba(214, 165, 66, .12);

  transition:
    height .3s ease;
}

.dashboard-bar-item>span {
  color: var(--muted);

  font-size: 10px;

  text-transform: capitalize;
}


/* ============================================================
   CASH SUMMARY
============================================================ */

.dashboard-summary-list {
  display: grid;

  gap: 3px;
}

.dashboard-summary-list>div {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 15px;

  padding: 13px 0;

  border-bottom:
    1px solid var(--line);
}

.dashboard-summary-list span {
  color: var(--muted);

  font-size: 12px;
}

.dashboard-summary-list strong {
  color: #f9ecd6;

  text-align: right;
}

.dashboard-summary-total {
  margin-top: 5px;

  border-bottom: 0 !important;
}

.dashboard-summary-total strong {
  font-size: 18px;

  color: var(--gold-light);
}


/* ============================================================
   EMPTY STATE
============================================================ */

.dashboard-empty-state {
  min-height: 190px;

  display: flex;

  flex-direction: column;

  align-items: flex-start;
  justify-content: center;

  gap: 8px;
}

.dashboard-empty-state.compact {
  min-height: 100px;
}

.dashboard-empty-state strong {
  color: #f7ead5;
}

.dashboard-empty-state p {
  max-width: 340px;

  margin: 0 0 8px;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.6;
}


/* ============================================================
   ROWS
============================================================ */

.dashboard-row-right {
  text-align: right;
}


/* ============================================================
   QR SUMMARY
============================================================ */

.dashboard-qr-summary {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 10px;
}

.dashboard-qr-summary>div {
  padding: 18px 12px;

  text-align: center;

  border: 1px solid var(--line);

  border-radius: 11px;

  background:
    rgba(255, 255, 255, .018);
}

.dashboard-qr-summary strong {
  display: block;

  margin-bottom: 6px;

  color: var(--gold-light);

  font-size: 25px;
}

.dashboard-qr-summary span {
  color: var(--muted);

  font-size: 11px;
}


/* ============================================================
   INVOICE
============================================================ */

.dashboard-invoice-box {
  margin: 0;
}


/* ============================================================
   RESPONSIVE DASHBOARD
============================================================ */

@media(max-width:1000px) {

  .dashboard-main-grid,
  .dashboard-bottom-grid {
    grid-template-columns: 1fr;
  }

}


@media(max-width:700px) {

  .dashboard-welcome {
    align-items: flex-start;

    flex-direction: column;

    gap: 10px;
  }

  .dashboard-chart {
    height: 220px;

    gap: 5px;
  }

  .dashboard-bar-value {
    display: none;
  }

  .dashboard-bar-item {
    grid-template-rows:
      1fr 22px;
  }

  .dashboard-qr-summary {
    grid-template-columns: 1fr;
  }

  .dashboard-qr-summary>div {
    display: flex;

    align-items: center;
    justify-content: space-between;

    text-align: left;

    padding: 13px 15px;
  }

  .dashboard-qr-summary strong {
    margin: 0;

    font-size: 21px;
  }

}

/* ============================================================
   DASHBOARD PERIOD FILTER
============================================================ */

.dashboard-controls {
  display: flex;

  align-items: center;

  gap: 10px;

  flex-wrap: wrap;
}

.dashboard-period-select {
  min-width: 145px;

  width: auto;
}

.dashboard-period-heading {
  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 12px;

  padding: 0 2px;

  color: var(--muted);
}

.dashboard-period-heading>span {
  color: var(--gold-light);

  font-size: 13px;

  font-weight: 750;
}

.dashboard-period-heading small {
  font-size: 11px;
}


/* YEAR HAS MORE BARS */

.dashboard-chart-year {
  grid-template-columns:
    repeat(12, minmax(0, 1fr));

  gap: 7px;
}


/* MONTH */

.dashboard-chart-month {
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
}


/* DAY */

.dashboard-chart-day {
  grid-template-columns:
    repeat(6, minmax(0, 1fr));
}


/* ============================================================
   MOBILE
============================================================ */

@media(max-width:700px) {

  .dashboard-controls {
    width: 100%;

    align-items: stretch;
  }

  .dashboard-period-select {
    width: 100%;

    min-height: 44px;
  }

  .dashboard-period-heading {
    align-items: flex-start;

    flex-direction: column;

    gap: 3px;
  }

  .dashboard-chart-year {
    gap: 3px;
  }

  .dashboard-chart-year .dashboard-bar-item>span {
    font-size: 8px;
  }

}

/* ============================================================
   DASHBOARD PERIOD SELECT
============================================================ */

.dashboard-period-control {
  display: flex;

  align-items: center;

  gap: 9px;

  padding: 6px 8px 6px 12px;

  border: 1px solid var(--line);

  border-radius: 10px;

  background:
    rgba(255, 255, 255, .018);
}

.dashboard-period-control label {
  color: var(--muted);

  font-size: 11px;

  font-weight: 700;

  text-transform: uppercase;

  letter-spacing: .07em;
}

.dashboard-period-select {
  width: auto;

  min-width: 125px;

  min-height: 38px;

  padding:
    7px 34px 7px 10px;

  border-color:
    rgba(214, 165, 66, .25);

  color: #fff3dc;

  cursor: pointer;
}


/* MOBILE */

@media(max-width:700px) {

  .dashboard-period-control {
    width: 100%;

    justify-content: space-between;
  }

  .dashboard-period-select {
    flex: 1;

    width: auto;

    min-height: 44px;
  }

}

/* ============================================================
   QR LABEL V2
============================================================ */

.qr-modal {
  width: min(900px, 94vw);
  max-height: 92vh;

  overflow: auto;
}

.qr-modal-layout {
  display: grid;

  grid-template-columns:
    minmax(280px, .8fr) minmax(300px, 1fr);

  gap: 24px;

  align-items: start;
}


/* PREVIEW */

.qr-label-preview {
  display: flex;

  justify-content: center;

  padding: 20px;

  border: 1px solid var(--line);

  border-radius: 14px;

  background:
    linear-gradient(145deg,
      rgba(255, 255, 255, .025),
      rgba(0, 0, 0, .14));
}


/* LABEL */

.qr-label {
  width: 260px;
  min-height: 402px;

  display: flex;
  flex-direction: column;

  padding: 18px;

  border: 2px solid #771313;

  border-radius: 8px;

  background: #fff;

  color: #17110e;

  box-shadow:
    0 16px 40px rgba(0, 0, 0, .35);
}


/* BRAND */

.qr-label-brand {
  display: flex;

  align-items: center;

  gap: 10px;
}

.qr-label-logo {
  width: 42px;
  height: 42px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex: 0 0 42px;

  border-radius: 50%;

  background: #761313;

  color: white;

  font-size: 23px;

  font-weight: 900;
}

.qr-label-brand strong {
  display: block;

  font-size: 15px;

  color: #17110e;
}

.qr-label-brand span {
  display: block;

  margin-top: 2px;

  color: #6f625b;

  font-size: 9px;

  text-transform: uppercase;

  letter-spacing: .08em;
}

.qr-label-divider {
  height: 2px;

  margin: 14px 0;

  background:
    linear-gradient(90deg,
      #761313,
      #d0a448);
}


/* PRODUCT */

.qr-label-product {
  text-align: center;
}

.qr-label-product>span {
  color: #761313;

  font-size: 9px;

  font-weight: 850;

  letter-spacing: .11em;
}

.qr-label-product h3 {
  margin: 7px 0 4px;

  color: #18110e;

  font-size: 19px;

  line-height: 1.15;
}

.qr-label-product small {
  color: #71635c;

  font-size: 10px;
}


/* QR */

.qr-label-code {
  display: flex;

  justify-content: center;

  margin: 13px 0 10px;
}

.qr-label-code img {
  width: 170px;
  height: 170px;

  object-fit: contain;
}


/* VALID */

.qr-label-valid {
  display: flex;

  align-items: center;
  justify-content: center;

  gap: 6px;

  color: #48713f;

  font-size: 10px;

  font-weight: 900;

  letter-spacing: .05em;
}

.qr-valid-dot {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: #5b8c50;
}

.qr-label-number {
  margin-top: 8px;

  color: #544945;

  font-family:
    "Courier New",
    monospace;

  font-size: 9px;

  text-align: center;

  word-break: break-all;
}


/* FOOTER */

.qr-label-footer {
  margin-top: auto;

  padding-top: 10px;

  border-top: 1px solid #e1dad6;

  color: #776a64;

  font-size: 8px;

  text-align: center;
}

.qr-label-footer strong {
  display: block;

  margin-top: 4px;

  color: #761313;

  font-size: 9px;

  letter-spacing: .13em;
}


/* SIDE INFORMATION */

.qr-modal-info {
  display: grid;

  gap: 10px;
}

.qr-info-card {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 13px 15px;

  border: 1px solid var(--line);

  border-radius: 10px;

  background:
    rgba(255, 255, 255, .018);
}

.qr-info-card span {
  color: var(--muted);

  font-size: 11px;
}

.qr-info-card strong,
.qr-info-card code {
  max-width: 60%;

  color: #f5e6cc;

  text-align: right;

  overflow-wrap: anywhere;
}

.qr-label-note {
  margin-top: 6px;

  padding: 16px;

  border:
    1px solid rgba(214, 165, 66, .18);

  border-radius: 11px;

  background:
    rgba(214, 165, 66, .035);
}

.qr-label-note strong {
  color: var(--gold-light);
}

.qr-label-note p {
  margin:
    8px 0 0;

  color: var(--muted);

  font-size: 12px;

  line-height: 1.55;
}

.qr-modal-actions {
  display: flex;

  gap: 10px;

  margin-top: 8px;
}


/* MOBILE */

@media(max-width:700px) {

  .qr-modal-layout {
    grid-template-columns: 1fr;
  }

  .qr-label-preview {
    padding: 14px;
  }

  .qr-label {
    width: min(260px,
        100%);
  }

  .qr-modal-actions {
    flex-direction: column;
  }

  .qr-modal-actions .btn {
    width: 100%;
  }

}


/* ============================================================
   LOGIN / AUTH V1
============================================================ */

body.auth-locked {
  overflow: hidden;
}

body.auth-locked .shell {
  visibility: hidden;
  pointer-events: none;
}


/* ============================================================
   LOGIN SCREEN
============================================================ */

.login-screen {
  position: fixed;
  inset: 0;

  z-index: 99999;

  display: flex;

  align-items: center;
  justify-content: center;

  padding: 24px;

  background:
    radial-gradient(circle at 50% 20%,
      rgba(122, 20, 20, .24),
      transparent 42%),
    #080605;
}

.login-screen.is-hidden {
  display: none;
}


.login-panel {
  width: min(430px,
      100%);

  padding: 32px;

  border:
    1px solid rgba(214, 165, 66, .18);

  border-radius: 18px;

  background:
    linear-gradient(145deg,
      rgba(29, 21, 17, .98),
      rgba(14, 10, 8, .98));

  box-shadow:
    0 30px 90px rgba(0, 0, 0, .55);
}


.login-brand {
  display: flex;

  align-items: center;

  gap: 12px;

  margin-bottom: 38px;
}


.login-brand-mark {
  width: 46px;
  height: 46px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex: 0 0 46px;

  border-radius: 12px;

  background:
    linear-gradient(145deg,
      #8b1919,
      #5b0909);

  border:
    1px solid rgba(214, 165, 66, .35);

  color: #f7d685;

  font-size: 24px;

  font-weight: 900;
}


.login-brand strong {
  display: block;

  color: #fff1db;

  font-size: 17px;
}


.login-brand span {
  display: block;

  margin-top: 3px;

  color: var(--muted);

  font-size: 10px;

  text-transform: uppercase;

  letter-spacing: .1em;
}


.login-heading {
  margin-bottom: 24px;
}


.login-heading h1 {
  margin:
    4px 0 8px;

  color: #fff3df;

  font-size: 28px;
}


.login-heading p:not(.eyebrow) {
  margin: 0;

  color: var(--muted);

  font-size: 13px;

  line-height: 1.5;
}


#login-form {
  display: grid;

  gap: 16px;
}


.login-field {
  display: grid;

  gap: 7px;
}


.login-field>span {
  color: #d7c5ad;

  font-size: 11px;

  font-weight: 700;
}


.login-field .input {
  width: 100%;

  min-height: 46px;
}


.login-submit {
  width: 100%;

  min-height: 48px;

  margin-top: 4px;

  justify-content: center;
}


.login-submit:disabled {
  opacity: .6;

  cursor: wait;
}


.login-error {
  padding: 11px 13px;

  border:
    1px solid rgba(211, 109, 100, .35);

  border-radius: 9px;

  background:
    rgba(211, 109, 100, .08);

  color: #ffc3bd;

  font-size: 12px;
}


.login-footer {
  margin-top: 26px;

  padding-top: 16px;

  border-top:
    1px solid var(--line);

  color: var(--muted);

  font-size: 10px;

  text-align: center;
}


/* ============================================================
   TOPBAR USER
============================================================ */

.topbar-user {
  display: flex;

  align-items: center;

  gap: 9px;
}


.topbar-user-text {
  display: grid;

  text-align: right;
}


.topbar-user-text strong {
  max-width: 190px;

  overflow: hidden;

  color: #f7ead5;

  font-size: 12px;

  text-overflow: ellipsis;

  white-space: nowrap;
}


.topbar-user-text small {
  margin-top: 2px;

  color: var(--gold);

  font-size: 9px;

  font-weight: 750;

  text-transform: uppercase;

  letter-spacing: .06em;
}


.logout-btn {
  color: #d8aaa4;
}


/* ============================================================
   ROLE HIDDEN NAV
============================================================ */

#nav .nav-item[hidden] {
  display: none !important;
}


/* ============================================================
   AUTH MOBILE
============================================================ */

@media(max-width:700px) {

  .login-screen {
    padding: 14px;
  }

  .login-panel {
    padding: 24px 20px;
  }

  .login-brand {
    margin-bottom: 28px;
  }

  .topbar-user-text {
    display: none;
  }

}

/* ============================================================
   USERS MODULE
============================================================ */

.users-metrics {
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
}

.users-layout {
  grid-template-columns:
    minmax(280px, .7fr) minmax(0, 1.5fr);

  gap: 18px;

  margin-top: 18px;
}


/* FORM */

.users-form {
  display: grid;

  gap: 15px;
}

.users-form label {
  display: grid;

  gap: 6px;
}

.users-form label>span {
  color: var(--muted);

  font-size: 11px;

  font-weight: 700;
}

.users-role-info {
  padding: 14px;

  border:
    1px solid rgba(214, 165, 66, .16);

  border-radius: 10px;

  background:
    rgba(214, 165, 66, .035);
}

.users-role-info strong {
  color: var(--gold-light);

  font-size: 12px;
}

.users-role-info p {
  margin:
    7px 0 0;

  color: var(--muted);

  font-size: 11px;

  line-height: 1.5;
}


/* LIST */

.users-list {
  display: grid;

  gap: 9px;
}

.user-item {
  display: grid;

  grid-template-columns:
    auto minmax(0, 1fr) auto;

  align-items: center;

  gap: 12px;

  padding: 13px;

  border:
    1px solid var(--line);

  border-radius: 11px;

  background:
    rgba(255, 255, 255, .015);
}

.user-avatar {
  width: 40px;
  height: 40px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background:
    linear-gradient(145deg,
      #7c1717,
      #4f0808);

  border:
    1px solid rgba(214, 165, 66, .25);

  color: #f5d37b;

  font-size: 13px;

  font-weight: 900;
}

.user-main {
  min-width: 0;
}

.user-name-row {
  display: flex;

  align-items: center;

  gap: 8px;

  flex-wrap: wrap;
}

.user-main strong {
  color: #f7ead7;

  font-size: 13px;
}

.user-main small {
  display: block;

  margin-top: 4px;

  color: var(--muted);

  font-size: 10px;
}

.user-actions {
  display: flex;

  gap: 7px;
}

.user-delete-btn {
  color: #ffc6bf;

  border-color:
    rgba(211, 109, 100, .35);
}


/* ============================================================
   RESPONSIVE
============================================================ */

@media(max-width:950px) {

  .users-layout {
    grid-template-columns: 1fr;
  }

}


@media(max-width:700px) {

  .users-metrics {
    grid-template-columns: 1fr;
  }

  .user-item {
    grid-template-columns:
      auto minmax(0, 1fr);
  }

  .user-actions {
    grid-column: 1 / -1;
  }

  .user-actions .btn {
    width: 100%;

    justify-content: center;
  }

}

/* ============================================================
   USERS MODULE POLISH
============================================================ */

.users-toolbar {
  display: grid;
  grid-template-columns:
    minmax(220px, 1fr) minmax(140px, 170px) minmax(150px, 180px);

  gap: 10px;

  margin-bottom: 14px;
}

.users-list-card {
  overflow: hidden;
}

.user-item {
  transition:
    border-color .15s ease,
    background .15s ease,
    transform .15s ease;
}

.user-item:hover {
  border-color:
    rgba(214, 165, 66, .22);

  background:
    rgba(255, 255, 255, .025);

  transform:
    translateY(-1px);
}

.user-name-row .pill {
  flex: 0 0 auto;
}

.user-actions .btn {
  min-height: 38px;
}

@media(max-width:800px) {

  .users-toolbar {
    grid-template-columns: 1fr;
  }

}

@media(max-width:700px) {

  .users-toolbar {
    gap: 8px;
  }

  .users-toolbar .input {
    width: 100%;
    min-height: 44px;
  }

}

/* ============================================================
   USER AUDIT
============================================================ */

.users-audit-card {
  margin-top: 18px;
}

.users-audit-list {
  display: grid;
  gap: 8px;
}

.users-audit-item {
  display: grid;

  grid-template-columns:
    auto minmax(0, 1fr);

  align-items: center;

  gap: 11px;

  padding: 12px 13px;

  border:
    1px solid var(--line);

  border-radius: 10px;

  background:
    rgba(255, 255, 255, .015);
}

.users-audit-icon {
  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-weight: 900;

  font-size: 15px;

  background:
    rgba(214, 165, 66, .08);

  color: var(--gold-light);
}

.audit-create {
  background:
    rgba(95, 160, 105, .08);

  color: #9fd1a7;
}

.audit-deactivate {
  background:
    rgba(211, 109, 100, .08);

  color: #efb0aa;
}

.audit-reactivate {
  background:
    rgba(214, 165, 66, .08);

  color: var(--gold-light);
}

.users-audit-text {
  min-width: 0;
}

.users-audit-text>div {
  display: flex;

  align-items: center;

  gap: 5px;

  flex-wrap: wrap;

  color: #e7d8c4;

  font-size: 12px;
}

.users-audit-text strong {
  color: #fff0d8;
}

.users-audit-text span {
  color: var(--muted);
}

.users-audit-text small {
  display: block;

  margin-top: 4px;

  color: var(--muted);

  font-size: 10px;
}

@media(max-width:700px) {

  .users-audit-item {
    align-items: flex-start;
  }

}

/* ============================================================
   AUDITORÍA
============================================================ */

.audit-page {
  display: grid;
  gap: 18px;
}

.audit-summary-grid {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.audit-summary-card {
  padding: 18px;
}

.audit-summary-card span {
  display: block;
  margin-bottom: 6px;
  font-size: 11px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: .08em;
}

.audit-summary-card strong {
  font-size: 26px;
  color: #fff0d8;
}

.audit-card {
  overflow: hidden;
}

.audit-subtitle {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.audit-toolbar {
  display: grid;
  grid-template-columns:
    minmax(220px, 1fr) minmax(150px, 190px) minmax(150px, 190px) minmax(150px, 180px);
  gap: 10px;
  margin-bottom: 18px;
}

.audit-timeline {
  position: relative;
  display: grid;
  gap: 8px;
}

.audit-event {
  display: grid;
  grid-template-columns:
    40px minmax(0, 1fr);
  gap: 12px;
  align-items: start;

  padding: 13px 14px;

  border:
    1px solid var(--line);

  border-radius: 12px;

  background:
    rgba(255, 255, 255, .015);

  transition:
    background .15s ease,
    border-color .15s ease,
    transform .15s ease;
}

.audit-event:hover {
  transform:
    translateY(-1px);

  border-color:
    rgba(214, 165, 66, .22);

  background:
    rgba(255, 255, 255, .025);
}

.audit-event-icon {
  width: 38px;
  height: 38px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  font-size: 12px;
  font-weight: 900;

  background:
    rgba(214, 165, 66, .08);

  color:
    var(--gold-light);
}

.audit-event-sales {
  background:
    rgba(95, 160, 105, .10);
  color: #9fd1a7;
}

.audit-event-expenses {
  background:
    rgba(211, 109, 100, .10);
  color: #efb0aa;
}

.audit-event-cash {
  background:
    rgba(95, 145, 190, .10);
  color: #a8c9e8;
}

.audit-event-users {
  background:
    rgba(168, 125, 210, .10);
  color: #cdb2ea;
}

.audit-event-inventory {
  background:
    rgba(214, 165, 66, .10);
  color: var(--gold-light);
}

.audit-event-body {
  min-width: 0;
}

.audit-event-main {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.audit-event-main>div {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  align-items: center;

  font-size: 13px;
}

.audit-event-main strong {
  color: #fff0d8;
}

.audit-event-main span {
  color: var(--muted);
}

.audit-event-main b {
  color: #e8d6bd;
  font-weight: 700;
}

.audit-event-main time {
  flex: 0 0 auto;

  color: var(--muted);

  font-size: 10px;
  white-space: nowrap;
}

.audit-event-meta {
  margin-top: 7px;

  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;

  color: var(--muted);

  font-size: 10px;
}

.audit-event-meta .pill {
  font-size: 9px;
}

.audit-empty {
  padding: 30px 18px;
}

@media(max-width:950px) {

  .audit-toolbar {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

}

@media(max-width:700px) {

  .audit-summary-grid {
    grid-template-columns: 1fr;
  }

  .audit-toolbar {
    grid-template-columns: 1fr;
  }

  .audit-event {
    grid-template-columns:
      34px minmax(0, 1fr);

    padding: 11px;
  }

  .audit-event-icon {
    width: 32px;
    height: 32px;
  }

  .audit-event-main {
    display: block;
  }

  .audit-event-main time {
    display: block;
    margin-top: 5px;
  }

}


