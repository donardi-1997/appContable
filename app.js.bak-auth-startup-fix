        </thead>

        <tbody>
          ${state.products.map(p => `
            <tr
              class="inventory-product-row"
              data-product-search="${(
      `${p.name || ''} ${p.sku || ''}`
    ).toLowerCase()}"
              data-product-name="${(
      p.name || ''
    ).toLowerCase()}"
