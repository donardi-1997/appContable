      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          closing_amount: amount
        })
      }
    );

    const data = await response.json();

    if (!response.ok) {
      throw new Error(
        data.detail ||
        'No fue posible cerrar la caja.'
      );
    }

    closeCashModal('#cash-close-modal');

    await loadCashRegisterPanel();

    const difference =
      Number(data.difference || 0);

