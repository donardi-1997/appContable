DATABASE_URL=sqlite:///./gato_contable.db
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5500
ADMIN_API_KEY=cambia-esta-clave

# ============================================================
# Electrónica - Proveedor
# ============================================================
# mock | dian
ELECTRONIC_INVOICE_PROVIDER=mock

# Ambiente DIAN: habilitacion | produccion
DIAN_ENVIRONMENT=habilitacion

# ============================================================
# Credenciales DIAN (requeridas solo cuando provider=dian)
# ============================================================

# Software ID asignado por la DIAN (UUID)
DIAN_SOFTWARE_ID=

# PIN del software registrado en DIAN
DIAN_SOFTWARE_PIN=

# NIT del proveedor tecnológico (quien registró el software en DIAN)
# Si el emisor registró su propio software, usar su propio NIT
DIAN_SOFTWARE_PROVIDER_NIT=

# Test Set ID (requerido solo en habilitacion)
DIAN_TEST_SET_ID=

# Ruta al certificado digital (.p12 o .pfx) en el servidor
# Ejemplo: /etc/certificados/facturacion.p12
DIAN_CERTIFICATE_PATH=

# Contraseña del certificado digital
DIAN_CERTIFICATE_PASSWORD=

# NIT del emisor (sin dígito de verificación)
DIAN_NIT=

# Dígito de verificación del NIT
DIAN_DV=

# ============================================================
# Resolución de numeración DIAN
# ============================================================
DIAN_RESOLUTION_NUMBER=
DIAN_RESOLUTION_PREFIX=FE
DIAN_RESOLUTION_FROM=
DIAN_RESOLUTION_TO=
DIAN_RESOLUTION_START_DATE=
DIAN_RESOLUTION_END_DATE=

# Clave técnica asignada por DIAN en la resolución de numeración
# Usada en el cálculo del CUFE (facturas de venta, exportación, tipo 04)
DIAN_TECHNICAL_KEY=

# ============================================================
# URLs de servicios web DIAN (NO cambiar salvo indicación)
# ============================================================
# DIAN_HABILITACION_URL=https://vpfe-habilitacion.dian.gov.co/WcfDianCustomerServices.svc
# DIAN_PRODUCCION_URL=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc
