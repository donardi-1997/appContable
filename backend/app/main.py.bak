from decimal import Decimal
from fastapi import Depends, FastAPI, HTTPException, status
from fastapi.middleware.cors import CORSMiddleware
from sqlalchemy import select
from sqlalchemy.orm import Session

from .db import Base, engine, get_db
from .models import Expense, Product, Sale, SaleItem
from .schemas import ExpenseCreate, ProductCreate, ProductRead, SaleCreate

Base.metadata.create_all(bind=engine)
app = FastAPI(title="Gato Contable API", version="0.1.0")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_credentials=True, allow_methods=["*"], allow_headers=["*"])


@app.get("/health")
def health() -> dict[str, str]:
    return {"status": "ok", "environment": "development"}


@app.get("/api/products", response_model=list[ProductRead])
def list_products(db: Session = Depends(get_db)):
    return db.scalars(select(Product).where(Product.active.is_(True)).order_by(Product.name)).all()


@app.post("/api/products", response_model=ProductRead, status_code=status.HTTP_201_CREATED)
def create_product(payload: ProductCreate, db: Session = Depends(get_db)):
    product = Product(**payload.model_dump())
    db.add(product)
    db.commit()
    db.refresh(product)
    return product


@app.post("/api/sales", status_code=status.HTTP_201_CREATED)
def create_sale(payload: SaleCreate, db: Session = Depends(get_db)):
    products = {p.id: p for p in db.scalars(select(Product).where(Product.id.in_([i.product_id for i in payload.items]))).all()}
    if len(products) != len({i.product_id for i in payload.items}):
        raise HTTPException(status_code=404, detail="Uno o más productos no existen")
    total = Decimal("0")
    items: list[SaleItem] = []
    for item in payload.items:
        product = products[item.product_id]
        if product.stock < item.quantity:
            raise HTTPException(status_code=409, detail=f"Stock insuficiente para {product.name}")
        total += product.price * item.quantity
        product.stock -= item.quantity
        items.append(SaleItem(product=product, quantity=item.quantity, unit_price=product.price))
    sale = Sale(number=f"V-{(db.scalar(select(Sale.id).order_by(Sale.id.desc())) or 0) + 1:05d}", customer_name=payload.customer_name, payment_method=payload.payment_method, total=total, status="pendiente", items=items)
    db.add(sale)
    db.commit()
    db.refresh(sale)
    return {"id": sale.id, "number": sale.number, "total": sale.total, "status": sale.status}


@app.get("/api/sales")
def list_sales(db: Session = Depends(get_db)):
    return db.scalars(select(Sale).order_by(Sale.created_at.desc())).all()


@app.post("/api/expenses", status_code=status.HTTP_201_CREATED)
def create_expense(payload: ExpenseCreate, db: Session = Depends(get_db)):
    expense = Expense(**payload.model_dump())
    db.add(expense)
    db.commit()
    db.refresh(expense)
    return expense


@app.get("/api/expenses")
def list_expenses(db: Session = Depends(get_db)):
    return db.scalars(select(Expense).order_by(Expense.created_at.desc())).all()
