ADMIN_API_KEY = os.getenv("ADMIN_API_KEY", "").strip()


def require_admin(
    x_admin_key: str | None = Header(
        default=None,
        alias="X-Admin-Key",
    ),
) -> None:

    if not ADMIN_API_KEY:
        raise HTTPException(
            status_code=500,
            detail="ADMIN_API_KEY no está configurada en el servidor",
        )

    if (
        not x_admin_key
        or not secrets.compare_digest(
            x_admin_key,
            ADMIN_API_KEY,
        )
    ):
        raise HTTPException(
            status_code=403,
            detail="Permiso exclusivo de administrador",
        )



