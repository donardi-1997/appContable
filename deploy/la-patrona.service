[Unit]
Description=La Patrona VIP - FastAPI Application
After=network.target

[Service]
Type=simple
User=lapatrona
Group=lapatrona
WorkingDirectory=/opt/la-patrona/app/backend
EnvironmentFile=/etc/la-patrona/la-patrona.env
ExecStart=/opt/la-patrona/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
