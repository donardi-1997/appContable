const views = {
  dashboard: {
    title: 'Resumen de hoy',
    render: dashboard
  },
  sales: {
    title: 'Ventas y caja',
    render: sales
  },
  inventory: {
    title: 'Inventario',
    render: inventory
  },
  expenses: {
    title: 'Gastos',
    render: expenses
  },
  invoices: {
    title: 'Facturación electrónica',
    render: invoices
  }
};

let currentView = 'dashboard';


function render(view = 'dashboard') {
  currentView = view;

  document.querySelector('#view-title').textContent =
    views[view].title;

  app.innerHTML = views[view].render();

  document.querySelectorAll('.nav-item').forEach(button => {
    button.classList.toggle(
      'active',
      button.dataset.view === view
    );
  });

  document.querySelectorAll('[data-view]').forEach(element => {
    element.onclick = () =>
      render(element.dataset.view);
  });

  document
    .querySelector('#new-sale')
    ?.addEventListener(
      'click',
      openSaleModal
    );

  document
    .querySelector('#new-product')
    ?.addEventListener(
      'click',
      openProductModal
    );

  document
    .querySelector('#new-expense')
    ?.addEventListener(
      'click',
      () =>
        toast(
          'Formulario de gasto será conectado después de ventas.'
        )
    );

  document
    .querySelector('#emit-test')
    ?.addEventListener(
      'click',
      () => {
        const number =
          state.testInvoices.length + 1;

        const invoice = {
          number:
            'GATO-TEST-' +
            String(number).padStart(4, '0'),

          customer:
            document.querySelector('#test-customer').value
            || 'Consumidor final',

          total:
            Number(
              document.querySelector('#test-total').value
            ) || 0,

          status:
            'Aceptada (prueba)',

          cufe:
            'SIM-' +
            crypto.randomUUID()
              .replaceAll('-', '')
              .slice(0, 18)
              .toUpperCase()
        };

        state.testInvoices.unshift(invoice);

        localStorage.setItem(
          'gato-test-invoices',
          JSON.stringify(state.testInvoices)
        );

        toast(
          'Factura de prueba generada.'
        );

        render('invoices');
      }
    );

  document
    .querySelector('#clear-tests')
    ?.addEventListener(
      'click',
      () => {
        state.testInvoices = [];

        localStorage.removeItem(
          'gato-test-invoices'
        );

        toast(
          'Historial de pruebas limpiado.'
        );

        render('invoices');
      }
    );
}


/* ============================================================
   API SYNC
============================================================ */

async function syncFromApi(showToast = true) {
  try {
    const [
      products,
      sales,
      expenses,
      inventoryMovements
    ] = await Promise.all([
      fetch(
        `${API_BASE}/api/products`
      ).then(response =>
        response.ok
          ? response.json()
          : Promise.reject()
      ),

      fetch(
        `${API_BASE}/api/sales`
      ).then(response =>
        response.ok
          ? response.json()
          : Promise.reject()
      ),

      fetch(
        `${API_BASE}/api/expenses`
      ).then(response =>
        response.ok
          ? response.json()
          : Promise.reject()
      ),

      fetch(
        `${API_BASE}/api/inventory/movements`
      ).then(response =>
        response.ok
          ? response.json()
          : Promise.reject()
      )
    ]);

    state.products = products;
    state.inventoryMovements = inventoryMovements;

    state.sales = sales.map(sale => ({
      id: sale.number,
      detail:
        `${sale.customer_name} · venta registrada`,
      total: Number(sale.total),
      payment: sale.payment_method,
      status: sale.status
    }));

    state.expenses = expenses.map(expense => ({
      concept: expense.concept,
      provider:
        expense.provider ||
        'Sin proveedor',
      value: Number(expense.value),
      date:
        new Date(
          expense.created_at
        ).toLocaleDateString('es-CO')
    }));

    render(currentView);

    if (showToast) {
      toast(
        'Datos sincronizados con la API'
      );
    }

    return true;

  } catch (error) {
    console.info(
      'API no disponible; usando datos de demostración'
    );

    return false;
  }
}


